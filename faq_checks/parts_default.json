{
 "_meta": {
  "format": "faq-parts/1",
  "what": "Functional parts of every task object at body_scale = (1, 1, 1), in the object's own mesh-local frame (metres and radians, or the mesh's own units: the milk-box mesh is not in metres, so its numbers are large). faq_checks.parts.scale_parts() multiplies them by an episode's actual body_scale (rules in the module docstring). Only the parts the ten FAQ criteria read are listed.",
  "structure": "tasks.<task>.<object uid> = {up_axis: mesh axis pointing up or null, parts: {<part name>: {...}}}",
  "provenance": {
   "measured_from_official_assets": {
    "how": "Mesh features of the official asset files (the meshes referenced by configs/<task>/random/gym_config.json): extreme points along an object's axes (mean of the vertices within 2-3 % of the extent at that end), centres and radii of rim / bottom slabs, hole centres of the rack, bounding boxes. They were measured with a mesh-feature routine at the body scales the evaluation configs use and divided by that scale, i.e. they are not hand-typed. Where the same part was measured at several body scales, the de-scaled values agree to within 2 % of the value (largest: water_pouring bottle.mouth, 1.6 % relative on one small component), i.e. within about 2 micrometres after scaling back.",
    "entries": [
     "click_bell.button.press (stroke from the official button.urdf: joint range [-0.005, 0] m, axis z; not scaled, see 'scaled')",
     "handle_basket.basket.mouth / floor, handle_basket.milk.bottom / top",
     "sample_loading.cube.bottom / mouth, sample_loading.rack.holes",
     "water_pouring.bottle / cup mouth and bottom",
     "mixer_operating.beaker.bottom",
     "mixer_operating.beaker_mixer.ring (the cross-circle of the mixer top: centre and radius are read off the texture mapped back onto the mesh, not derived from the mesh shape)",
     "table_rearrangement fork / spoon / plate bounding boxes"
    ]
   },
   "measured_with_scripts_measure_faq_parts_py": {
    "how": "scripts/measure_faq_parts.py reproduces these numbers from the asset files (the drawer meshes come from EmbodiChain's asset pack, pass --drawer-dir).",
    "entries": [
     "items_handover.pen.tip / tail",
     "items_handover.holder.mouth",
     "item_assembly.guijiao1 / guijiao2 end_head (the +x end of each tube mesh = functional tail / head)",
     "drawer_open_place.drawer.floor / cavity (flat top face of the inner box's bottom plate; height above it), drawer.slide (URDF prismatic joint, axis x, 0-0.2 m), duck.center"
    ]
   },
   "default_size_constants": {
    "how": "Values taken over from the default-size measurements of the official pipette and beaker (pipette tip at body_scale 3, beaker mouth at body_scale 1.4 / 1.4 / 1.5), divided by those scales; pipette.button_slide is the URDF joint range of the pipette's button.",
    "entries": ["manipulate_pipette.pipette.tip / button_slide", "manipulate_pipette.beaker1.mouth"]
   }
  },
  "not_included": "The mixer's switch (mixer_switch.flip.range) is not part of the official asset (the official mixer button is a contact region, not a joint), so it has no entry; see mixer_operating_faq.py."
 },
